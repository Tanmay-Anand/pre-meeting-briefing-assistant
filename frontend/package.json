{
  "name": "leadlens-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LeadLens - AI pre-meeting briefing assistant, delivered as a CRM-agnostic MV3 sidecar.",
  "workspaces": [
    "demo-crm"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "demo-crm:dev": "npm run dev --workspace leadlens-demo-crm",
    "demo-crm:build": "npm run build --workspace leadlens-demo-crm"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.1.28",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
