{
  "manifest_version": 3,
  "name": "AI CRM Copilot",
  "version": "1.0.0",
  "description": "AI-powered CRM pre-meeting briefing assistant",

  "action": {
    "default_title": "Open AI CRM Copilot"
  },

  "permissions": [
    "storage",
    "sidePanel",
    "webRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "side_panel": {
    "default_path": "index.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.leadrat.com/*",
        "https://crm.builder.leadratd.com/*",
        "https://leads-crm-frontend-nine.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}