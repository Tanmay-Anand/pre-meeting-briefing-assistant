# Extension build-time config (background/backendClient.ts). Copy to .env for local dev —
# .env* is already git-ignored. Both are optional; unset falls back to the values noted below.

# Base URL of the LeadLens backend. Defaults to http://localhost:8080 if unset.
VITE_LEADLENS_API_BASE=http://localhost:8080

# Must match backend/leadlens's LEADLENS_API_TOKEN. Leave unset for local dev — TokenAuthFilter
# passes every request through (with a logged warning) when the backend itself has no token
# configured either.
VITE_LEADLENS_API_TOKEN=
