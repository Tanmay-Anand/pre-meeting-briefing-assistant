# --- Secrets / local config ---
# One env file per CRM adapter (IMPLEMENTATION_PLAN.md G.7): .env.demo, .env.leadrat, ...
# The real files never get committed; the .example templates beside them always do, so a new
# teammate can see which keys an adapter needs without anyone leaking a value.
.env
.env.*
!.env.example
!.env.*.example

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
build/
*.local
.vite/
coverage/
playwright-report/
test-results/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Java / backend ---
target/
*.class

# --- IDE ---
.idea/
*.iml
*.iws
*.ipr
.vscode/

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs / local runtime state ---
*.log
# Written by scripts/service-start.sh; recreated on demand, never shared.
logs/
