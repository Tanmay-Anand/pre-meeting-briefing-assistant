# --- Secrets / local config ---
# leadlens/.env carries VITE_AI_SDK_ADMIN_PASSWORD - never committed. The .env.example
# template beside it always is, so a new teammate can see which keys are needed without anyone
# leaking a value.
.env
.env.*
!.env.example
!.env.*.example

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
build/
*.local
.vite/
coverage/
playwright-report/
test-results/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE ---
.idea/
*.iml
*.iws
*.ipr
.vscode/

# --- OS ---
.DS_Store
Thumbs.db
*.log
