# DemoCrmAdapter configuration (IMPLEMENTATION_PLAN.md G.7).
#
# Copy to .env.demo, which is git-ignored. One file per adapter: an adapter reads only its
# own leadlens.crm.<crmKey>.* prefix, so adding or rotating a CRM never touches another
# CRM's configuration.

leadlens.crm.demo.base-url=http://localhost:8080
leadlens.crm.demo.service-user=u-priya
