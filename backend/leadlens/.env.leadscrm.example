# LeadsCrmAdapter configuration (IMPLEMENTATION_PLAN.md G.7).
#
# Copy to .env.leadscrm, which is git-ignored. One file per adapter: an adapter reads only
# its own leadlens.crm.<crmKey>.* prefix, so adding or rotating a CRM never touches another
# CRM's configuration.

leadlens.crm.leadscrm.base-url=http://localhost:8090/leads-crm
leadlens.crm.leadscrm.frontend-origin=http://localhost:5173

# Cognito - this adapter authenticates against leads-crm-backend's own /leads API as a single
# service identity (Appendix 2 Q5 is still open; real per-user auth is unresolved).
leadlens.crm.leadscrm.cognito-region=ap-south-1
leadlens.crm.leadscrm.cognito-client-id=
leadlens.crm.leadscrm.service-username=
leadlens.crm.leadscrm.service-password=

# LeadLens-side identity this adapter's serviceIdentities() presents as (Phase 9's scheduler
# uses this) - a different concept from the Cognito credentials above.
leadlens.crm.leadscrm.tenant-id=leadscrm-default
leadlens.crm.leadscrm.service-user-id=leadscrm-service

# leads-crm-backend's OWN tenant UUID for the service user above (its custom:tenantId claim -
# decode the ID token after a successful InitiateAuth to find it; the access token this adapter
# sends as the bearer never carries it). Required: TenantFilter 400s on a missing/malformed
# x-tenant-id.
leadlens.crm.leadscrm.crm-tenant-id=

# ai-query-sdk's single admin password. Gates BOTH the meeting-transcript evidence source
# (AiSdkMeetingClient) and the AI_NARRATIVE briefing section (AiSdkQueryClient) - one password,
# one SDK instance, two consumers. Leave unset to disable both: everything else on this adapter
# still works, and the briefing renders in full minus the narrative section.
#
# Same value as leads-crm-backend's own AI_SDK_ADMIN_PASSWORD (.env.example there) when that is
# set - it is literally the same secret from two sides: the host sets it as the SDK's actual
# password (synced on every boot, no OTP needed), this adapter uses it to authenticate as that
# admin. If the host instead left AI_SDK_ADMIN_PASSWORD unset, this is whatever password was set
# through the one-time /ai-sdk/setup OTP flow.
leadlens.crm.leadscrm.ai-sdk-admin-password=

# Optional overrides for the narrative section. Left unset, AiSdkQueryClient asks a sensible
# default question (see LeadsCrmProperties.DEFAULT_QUESTION) with a 25s timeout - shorter than
# the extension's own 60s poll budget, so a slow SDK degrades this one section rather than
# timing out the whole run.
# leadlens.crm.leadscrm.ai-sdk-question=
# leadlens.crm.leadscrm.ai-sdk-query-timeout=PT25S
