# Extension build-time config (background/aiSdkClient.ts). Copy to .env for local dev —
# .env* is already git-ignored.
#
# There is no backend of this extension's own any more - it calls leads-crm-backend's mounted
# ai-query-sdk instance directly. That means VITE_AI_SDK_ADMIN_PASSWORD ships inside the built
# extension bundle, which is public. Accepted for a hackathon-scale, single-tenant local demo
# only - see README "What this gave up" before pointing this at anything else.

# Base URL of leads-crm-backend, including its context path. Defaults to
# http://localhost:8090/leads-crm if unset.
VITE_AI_SDK_BASE_URL=http://localhost:8090/leads-crm

# Must match leads-crm-backend's AI_SDK_ADMIN_PASSWORD (or whatever password was set through
# /ai-sdk/setup if that env var was left unset there).
VITE_AI_SDK_ADMIN_PASSWORD=

# Optional override of the question sent on every query. Leave unset for a sensible default.
# VITE_AI_SDK_QUESTION=
